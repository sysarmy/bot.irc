# IRC connection
IRC_HOST=irc.example.net
IRC_PORT=6697
IRC_TLS=true
IRC_NICK=bofh
IRC_USERNAME=bofh
IRC_REALNAME=Sysarmy BOFH IRC bot
# Comma-separated channels to join.
IRC_CHANNELS="#sysarmy,#sysarmy-offtopic,#jobs"

# Comma-separated Matterbridge IRC nicknames.
IRC_BRIDGE_NICKS="nbot"

# Container UID/GID; use `id -u` and `id -g` on Linux if these defaults differ.
PUID=1000
PGID=1000

# Recommended: authenticate with a registered NickServ account via SASL.
IRC_SASL_USERNAME=bofh
IRC_SASL_PASSWORD=change-me

# Optional server-level PASS, normally not the NickServ password.
# IRC_SERVER_PASSWORD=

# Optional command API credentials
WEATHER_key=
COIN_key=
FULBO_token=
SUBTE_clientID=
SUBTE_clientSecret=
TFL_key=
